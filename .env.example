# Preencha GROQ_API_KEY localmente no arquivo .env (não versionado).
GROQ_API_KEY=

# IDs consultados na documentação de modelos da Groq em 2026-09-29.
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_STRONG=openai/gpt-oss-120b
GROQ_MODEL_VISION=qwen/qwen3.8-27b

# Parâmetros padrão para chamadas de geração.
GROQ_TEMPERATURE=0
GROQ_MAX_TOKENS=1024
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=3

# Ingestão e OCR local (não exigem chamadas à API Groq).
MAX_DOCUMENT_MB=30
OCR_LANGUAGES=por+eng
OCR_MIN_NATIVE_CHARS=20
OCR_TIMEOUT_SECONDS=60
OCR_RENDER_DPI=200

# Persistência/RAG: embeddings calculados localmente, sem API de embeddings.
CHROMA_COLLECTION_NAME=do_policy_chunks_v1
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
VECTOR_CHUNK_SIZE_CHARS=1200
VECTOR_CHUNK_OVERLAP_CHARS=150
RAG_TOP_K=5

# Provider selection; Groq retained. Fill keys only in local .env.
LLM_PROVIDER=groq
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-5.6-luna
OPENAI_MODEL_INTERMEDIATE=gpt-5.6-terra
OPENAI_MODEL_STRONG=gpt-5.6-sol
OPENAI_REASONING_EFFORT=low
LLM_MAX_RETRY_WAIT_SECONDS=30
# Optional: LLM_MAX_TOKENS=4096, LLM_TIMEOUT_SECONDS=30
# Windows executable if outside PATH: TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe


# E1 local retrieval and semantic batching; no model-family migration implied.
# auto retains the legacy path for short documents; optimized/legacy are explicit.
PUBLIC_EXTRACTION_STRATEGY=auto
PUBLIC_EXTRACTION_AUTO_MIN_PAGES=8
PUBLIC_EXTRACTION_AUTO_MIN_CHUNKS=20
PUBLIC_RETRIEVAL_BATCH_CHARS=20000
PUBLIC_RETRIEVAL_INITIAL_TOP_N=2
PUBLIC_RETRIEVAL_EXPANDED_TOP_N=4
# Operational review threshold, not a calibrated correctness probability.
PUBLIC_EXTRACTION_CONFIDENCE_THRESHOLD=0.75
# Empty roles inherit current provider models until dashboard reconciliation.
EXTRACTION_MODEL_SIMPLE=
EXTRACTION_MODEL_INTERPRETATION=
EXTRACTION_MODEL_VERIFICATION=
EXTRACTION_MODEL_COMPARISON=

# E2 governed routing: optional in general application; mandatory in authorized pilot.
# Does not grant authorization to run a public document.
MODEL_ROUTING_ENABLED=false
MODEL_ROUTING_EXTRACTION_PRIMARY=gpt-5.6-luna
MODEL_ROUTING_EXTRACTION_TECHNICAL_FALLBACKS=gpt-5.4-mini-2026-03-17
MODEL_ROUTING_EXTRACTION_ESCALATIONS=gpt-5.6-terra
MODEL_ROUTING_INTERPRETATION_PRIMARY=gpt-5.6-terra
MODEL_ROUTING_INTERPRETATION_TECHNICAL_FALLBACKS=gpt-5.4-2026-03-05
MODEL_ROUTING_INTERPRETATION_ESCALATIONS=gpt-5.6-sol
MODEL_ROUTING_COMPARISON_PRIMARY=gpt-5.6-terra
MODEL_ROUTING_COMPARISON_TECHNICAL_FALLBACKS=gpt-5.4-2026-03-05
MODEL_ROUTING_COMPARISON_ESCALATIONS=gpt-5.6-sol
MODEL_ROUTING_VERIFIER_PRIMARY=gpt-5.6-sol
MODEL_ROUTING_VERIFIER_TECHNICAL_FALLBACKS=gpt-5.6-terra,gpt-5.2-2025-12-11
MODEL_ROUTING_VERIFIER_ESCALATIONS=
MODEL_ROUTING_AUXILIARY_PRIMARY=gpt-5.4-mini-2026-03-17
MODEL_ROUTING_AUXILIARY_TECHNICAL_FALLBACKS=gpt-4.1-mini-2025-04-14
MODEL_ROUTING_AUXILIARY_ESCALATIONS=
# E2 hard limits live in the validated policy/control; no same-model retry.
